# Copy to .env (git-ignored). Never commit real values.

# App (public: only the Supabase URL and publishable key are ever bundled into the app)
EXPO_PUBLIC_API_MODE=mock            # mock | supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ingest script (server side only, never in app code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # Supabase "secret" key
GEMINI_API_KEY=                      # free tier key from Google AI Studio
FRED_API_KEY=
SEC_USER_AGENT="AppName contact@example.com"
# GROQ_API_KEY=                      # optional fallback, only if the Groq adapter is built
